{
  "expo": {
    "name": "CalorieClick AI",
    "slug": "calorieclick-ai",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/CalorieClick.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.priyank.calorieclick",
      "buildNumber": "5", 
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "We need camera access to scan meals and barcodes.",
        "NSAppTransportSecurity": { "NSAllowsArbitraryLoads": true },
        "ITSAppUsesNonExemptEncryption": false
      "icon": "./assets/CalorieClick.png",
      "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
      }
    },
    "android": {
      "package": "com.priyank.calorieclick",
      "permissions": ["android.permission.CAMERA"]
    },
    "extra": {
      "eas": { "projectId": "bade0b52-fdda-452c-b6f3-76247faf377d" }
    },
    "plugins": ["expo-camera"]
  }
}

